# Copy this to .env and fill in your values
# NEVER commit the real .env to git

# ---- MLflow -------------------------------------------------------
# Local dev:
MLFLOW_TRACKING_URI=http://localhost:5000
# AWS hosted (replace IP):
# MLFLOW_TRACKING_URI=http://1.2.3.4:5000

# ---- AWS ----------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# S3 bucket for MLflow artifact store (created by mlflow server --backend-store-uri)
MLFLOW_S3_BUCKET=my-mlflow-artifacts

# ---- Feature Store ------------------------------------------------
# S3 bucket used for raw data, offline feature parquet, and pipeline artifacts
FEATURE_STORE_BUCKET=my-fraud-feature-store

# ---- Model serving ------------------------------------------------
MODEL_NAME=fraud-detection-lr
MODEL_STAGE=Staging
FRAUD_THRESHOLD=0.5
ARTIFACTS_DIR=artifacts/

# ---- App Runner service ARN (from aws_setup.sh) -------------------
APPRUNNER_SERVICE_ARN=arn:aws:apprunner:us-east-1:123456789012:service/fraud-detection-api/...
